# ============================================================
# School-OS Backend — Environment Variables Reference
# Copy this file to .env and fill in the values.
# NEVER commit the actual .env file to version control.
# ============================================================

# ---- Django Core ----
SECRET_KEY=change-me-to-a-long-random-string-in-production
DEBUG=True   # Set to False in production

# ---- Hosts / CORS ----
# Comma-separated. Leave blank to use the defaults defined in settings.py.
ALLOWED_HOSTS=
# Production example (Railway):
#   ALLOWED_HOSTS=school-os-backend.up.railway.app
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Production example (after Vercel deploy):
#   CORS_ALLOWED_ORIGINS=https://school-os.vercel.app,http://localhost:3000

# ---- Database ----
# Development: SQLite (default when DATABASE_URL is unset)
DATABASE_URL=

# Production: PostgreSQL — paste the connection string from Railway / Render dashboard
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DB_NAME

# ---- Email ----
# Development: emails are printed to the terminal console
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Production: replace with SMTP backend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-specific-password
# Gmail: enable 2-FA and generate an App Password at:
# https://support.google.com/accounts/answer/185833

DEFAULT_FROM_EMAIL=School-OS <noreply@school-os.com>
SUPPORT_EMAIL=support@school-os.com

# ---- Frontend ----
# Used in password-reset email links
FRONTEND_URL=http://localhost:3000
# Production example:
#   FRONTEND_URL=https://school-os.vercel.app

